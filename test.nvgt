#include "src/nv_audio/main.nvgt"
#include "speech.nvgt"
nv_audio p;
void test_run(const string &in filename = "music.ogg", const string &in data = "") {
	set_sound_global_hrtf(true);
	show_window("NVGT 3d sound demo");
	nv_audio_positional@ s = p.play(filename, vector(0, 0, 0), looping = true, data = data);
	if (@s == null) {
		alert("Error", "The sound could not be loaded");
		return;
	}
	s.handle.volume = -7;
	alert("Info", "Arrows to move, Q and E to change direction, F to report the current direction, C for coordinates.");
	int x = 0;
	int y = 0;
	int z = 0;
	double angle = 0;
	s.handle.volume = s.volume;
	while (true) {
		if (key_pressed(KEY_ESCAPE))
			exit();
		if (key_pressed(KEY_LEFT))
			x--;
		if (key_pressed(KEY_RIGHT))
			x++;
		if (key_pressed(KEY_DOWN))
			y--;
		if (key_pressed(KEY_UP))
			y++;
		if (key_pressed(KEY_PAGEDOWN))
			z--;
		if (key_pressed(KEY_PAGEUP))
			z++;
		if (key_pressed(KEY_Q)) angle = turnleft(angle, 45);
		if (key_pressed(KEY_E)) angle = turnright(angle, 45);
		if (key_pressed(KEY_HOME)) {
			s.set_start_values(s.pan, s.volume, s.pitch + 1);
		}
		if (key_pressed(KEY_I)) {
			speak("Volume is " + s.volume + ", pitch " + s.pitch);
		}
		if (key_pressed(KEY_F)) speak(angle);
		if (key_pressed(KEY_C)) speak(x + ", " + y + ", " + z);
		if (p.rotation != angle) p.rotation = angle;
		p.listener = vector(x, y, z);
		wait(5);
	}
}
#if_not include
	void main() {
		p.behind_pitch_decrease = 3.0;
		test_run();
	}
#endif
