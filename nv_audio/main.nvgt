#include "base_item.nvgt"
#include "items/*.nvgt" /**/
#include "rotation.nvgt"
enum nv_audio_type {
	NV_AUDIO_TYPE_STATIONARY = 0,
	NV_AUDIO_TYPE_POSITIONAL
}
class nv_audio {
	float rolloff = 0.5;
	float directional_attenuation_factor = 1;
	float behind_pitch_decrease = 0.0;
	protected double s_rotation;
	int max_distance = 0;
	bool y_is_elevation = false;
	nv_audio_item@[] items();
	mixer@ mix;
	protected vector _listener_pos;
	pack_file@ pack;
	nv_audio(mixer@ mix = sound_default_mixer, pack_file@ pack = cast<pack_file@>(sound_default_pack)) {
		if (@mix != null)
			@this.mix = @mix;
		else
			@this.mix = mixer();
		@this.pack = @pack;
	}
	nv_audio_stationary@ play(const string &in filename, pack_file@ pack, bool looping = false, bool persist = false, bool wait = false, bool immediate = true, float pan = 0, double volume = 0, double pitch = 100, const string &in owner = "", const string &in data = "") {
		clean_sounds();
		nv_audio_stationary s(this, filename, looping, persist, pan, volume, pitch, owner, data);
		@s.pack = @pack;
		if (immediate)
			s.play(wait);
		else
			s.load();
		items.insert_last(@s);
		return @s;
	}
	nv_audio_stationary@ play(const string &in filename, bool looping = false, bool persist = false, bool wait = false, bool immediate = true, float pan = 0, double volume = 0, double pitch = 100, const string &in owner = "", const string &in data = "") {
		return play(filename, @pack, looping, persist, wait, immediate, pan, volume, pitch, owner, data);
	}
	nv_audio_positional@ play(
		const string &in filename, pack_file@ pack, vector v, bool looping = false, bool persist = false, bool wait = false, bool immediate = true, float pan = 0, double volume = 0, double pitch = 100,
		int left_range = 0, int right_range = 0, int backward_range = 0, int forward_range = 0, int lower_range = 0, int upper_range = 0, 
		const string &in owner = "", const string &in data = ""
	) {
		clean_sounds();
		nv_audio_positional s(this, filename, v, looping, persist, pan, volume, pitch, left_range, right_range, backward_range, forward_range, lower_range, upper_range, owner, data);
		@s.pack = @pack;
		if (immediate)
			s.play(wait);
		else
			s.load();
		items.insert_last(@s);
		return @s;
	}
	nv_audio_positional@ play(
		const string &in filename, vector v, bool looping = false, bool persist = false, bool wait = false, bool immediate = true, float pan = 0, double volume = 0, double pitch = 100,
		int left_range = 0, int right_range = 0, int backward_range = 0, int forward_range = 0, int lower_range = 0, int upper_range = 0,
		const string &in owner = "", const string &in data = ""
	) {
		return play(
			filename, @pack, v, looping, persist, wait, immediate, pan, volume, pitch,
			left_range, right_range, backward_range, forward_range, lower_range, upper_range, 
			owner, data
		);
	}
	nv_audio_item@[] get_items(const string &in owner) const {
		nv_audio_item@[] ret;
		for (uint i = 0; i < this.items.length(); i++) {
			if (this.items[i].owner == owner) ret.insert_last(@this.items[i]);
		}
		return ret;
	}
	bool update_sounds(const string &in owner, vector position) {
		nv_audio_item@[] items = this.get_items(owner);
		if (items.length() <= 0) return false;
		bool updated = false;
		for (uint i = 0; i < items.length(); i++) {
			if (items[i].type != NV_AUDIO_TYPE_POSITIONAL) continue;
			if (update_sound(items[i], position, false)) updated = true;
		}
		if (updated) update_sound_positions();
		return updated;
	}
	bool update_sound(nv_audio_item@ snd, vector cd, bool call_main_update = true) {
		if (@snd == null || snd.type != NV_AUDIO_TYPE_POSITIONAL) return false;
		nv_audio_positional@ s = cast<nv_audio_positional@>(snd);
		if (@s == null) return false;
		s.position = cd;
		if (call_main_update) update_sound_positions();
		return true;
	}
	void update_sound_positions(bool force = false) {
		clean_sounds();
		for (uint i = 0; i < items.length(); i++) {
			if (items[i].type == NV_AUDIO_TYPE_POSITIONAL) {
				nv_audio_positional@ snd = cast < nv_audio_positional@ > (items[i]);
				if (@snd == null) continue;
				snd.update(force);
			}
		}
	}
	bool destroy(nv_audio_item@ handle) {
		if (@handle == null) return false;
		if (@handle.handle != null && (handle.handle.playing || handle.handle.paused))
			handle.handle.stop();
		if (handle.handle.active)
			handle.handle.close();
		int i = items.find_by_ref(handle);
		if (i > -1) {
			items.remove_at(i);
			return true;
		}
		return false;
	}
	int destroy(nv_audio_item@[] handles) {
		if (handles.length() <= 0) return 0;
		int count = 0;
		for (uint i = 0; i < handles.length(); i++) {
			if (this.destroy(@handles[i])) count++;
		}
		return count;
	}
	int destroy(const string &in owner) {
		return this.destroy(this.get_items(owner));
	}
	int clean_sounds() {
		int cleaned = 0;
		for (uint i = 0; i < items.length(); i++) {
			if (!items[i].handle.playing && items[i].persist == false) {
				if (items[i].handle != null && items[i].handle.active)
					items[i].handle.close();
				items.remove_at(i);
				cleaned++;
			}
		}
		return cleaned;
	}
	void set_rotation(double r) property {
		s_rotation = r;
		update_sound_positions(true);
	}
	double get_rotation() const property {
		return s_rotation;
	}
	void update_listener(vector cd, double rotation) {
		listener = cd;
		if (this.rotation != rotation) this.rotation = rotation;
	}
	bool destroy_all() {
		return this.destroy(this.items) > 0;
	}
	void pause_all() {
		for (uint i = 0; i < this.items.length(); i++) {
			if (@this.items[i].handle != null && this.items[i].handle.playing)
				this.items[i].handle.pause();
		}
	}
	void resume_all() {
		for (uint i = 0; i < this.items.length(); i++) {
			if (this.items[i].handle != null && this.items[i].handle.paused)
				this.items[i].play();
		}
	}
	void set_listener(vector v) property {
		_listener_pos = vector(v.x, v.y, v.z);
		if (y_is_elevation)
			_listener_pos = vector(_listener_pos.x, _listener_pos.z, _listener_pos.y);
		// Set audio engine listener to origin since we pass rotated listener-relative coordinates
		sound_set_listener_position(vector(0, 0, 0));
		update_sound_positions();
	}
	vector get_listener() const property {
		return _listener_pos;
	}
}
