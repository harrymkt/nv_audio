abstract class nv_audio_item {
	int type;
	nv_audio@ parent;
	bool persist;
	bool looping;
	bool played = false;
	bool loaded = false;
	string filename;
	sound handle;
	string owner;
	string data;
	float pan = 0;
	double volume = 0, pitch = 100;
	pack_file@ pack = null;
	nv_audio_item(int type, nv_audio@ parent, const string &in filename, bool looping = false, bool persist = false, float pan = 0, double volume = 0, double pitch = 100, const string &in owner = "", const string &in data = "") {
		this.type = type;
		@this.parent = parent;
		this.filename = filename;
		this.looping = looping;
		if (looping)
			this.persist = true;
		else
			this.persist = persist;
		this.owner = owner;
		this.data = data;
		this.pan = pan;
		this.volume = volume;
		this.pitch = pitch;
	}
	bool play(bool wait = false) {
		if (!loaded)
			load();
		if (loaded) {
			handle.pan = pan;
			handle.volume = volume;
			handle.pitch = pitch;
			bool result = looping ? handle.play_looped() : (wait ? handle.play_wait() : handle.play());
			if (!looping)
				played = true;
			return result;
		}
		return false;
	}
	int opCmp(const nv_audio_item@other) const {
		if (@other == @this) return 0;
		return -1;
	}
	void load() {
		if (!loaded) {
			if (!data.empty()) loaded = handle.load_memory(data);
			else {
				if (@pack == null) loaded = handle.load(filename);
				else loaded = handle.load(filename, @pack);
			}
		}
		if (loaded)
			handle.set_mixer(@parent.mix);
	}
	void set_start_values(float pan, double volume, double pitch) {
		this.pan = pan;
		this.volume = volume;
		this.pitch = pitch;
		handle.pan = pan;
		handle.volume = volume;
		handle.pitch = pitch;
	}
}
